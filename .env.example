# Copy to .env on the server and fill in. Never commit .env.

# Host port on 127.0.0.1 that nginx proxies to (3000 = wine organizer, 2283 = Immich)
APP_PORT=3005

# At least 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Creates the first user (Owner role) on first start if no user exists
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Nightly backups (03:00, server local time)
BACKUP_KEEP=30
# BACKUPS_ENABLED=true

TZ=Europe/Oslo
